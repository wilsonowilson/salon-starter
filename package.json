{
	"name": "salon",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"db:push": "drizzle-kit push",
		"db:seed": "node --env-file=.env src/lib/server/db/seed.js",
		"db:studio": "drizzle-kit studio",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"auth:schema": "auth generate --config src/lib/server/auth.js --output src/lib/server/db/auth.schema.js --yes",
		"test:e2e": "playwright install chromium && playwright test",
		"db:push:test": "drizzle-kit push --config drizzle.config.test.js"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-netlify": "^7.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"auth": "^1.7.7",
		"better-auth": "^1.7.7",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"postgres": "^3.4.9",
		"svelte": "^5.57.1",
		"tailwindcss": "^4.3.0",
		"vite": "^8.3.0",
		"vitest": "^4.1.11"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
